# Salin file ini menjadi .env.local dan isi nilainya.
# File .env.local TIDAK boleh di-commit ke Git (sudah ada di .gitignore).

# Nomor WhatsApp untuk tombol CTA
# Format: kode negara tanpa + diikuti nomor (misal: 628123456789)
# TODO: konfirmasi ke perusahaan
NEXT_PUBLIC_WHATSAPP_NUMBER=62XXXXXXXXXX

# Jika nanti menggunakan Google Maps Embed API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Environment
# Nilai: development | production
NODE_ENV=development
